# ╔══════════════════════════════════════════════════════════════════╗
# ║  FORMULA SETTINGS — tune the bot here, no code changes needed.      ║
# ║  Placeholder formula active now. Swap these for YOUR values later.  ║
# ╚══════════════════════════════════════════════════════════════════╝

# Which strategy to run: crt | my_formula | ema_crossover
STRATEGY=crt

# ── CRT (Candle Range Theory) — the core strategy ──
# RANGE_LOOKBACK: how many prior candles form the range (1 = previous candle).
CRT_RANGE_LOOKBACK=1
# TARGET_MODE: "range" (aim for opposite side of the range) or "rr" (fixed reward:risk).
CRT_TARGET_MODE=range
CRT_RISK_REWARD=2.0
# Extra cushion beyond the sweep wick for the stop, as a % of price.
CRT_STOP_BUFFER_PCT=0.0
# Skip setups whose reward:risk is below this.
CRT_MIN_RR=1.0

# ── Account & risk ──
STARTING_BALANCE=10000
RISK_PCT=1

# ── Instrument / timeframe ──
# Note: MT5 symbols usually have NO underscore (EURUSD); OANDA uses EUR_USD.
INSTRUMENT=EURUSD
GRANULARITY=D

# ── MT5 broker (Nigeria-friendly: IC Markets, Exness, XM, ... — Windows/VPS) ──
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# ── OANDA (NOT available in Nigeria — kept for completeness) ──
OANDA_ENVIRONMENT=practice
OANDA_ACCOUNT_ID=
OANDA_ACCESS_TOKEN=

# ── SaaS / hosting ──
# Turn on ONLY when going live with per-customer subdomains (needs wildcard DNS + TLS).
SUBDOMAIN_GATING=off

# ── Trade alerts (platform Telegram bot: used for per-user alerts + password resets) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
